# =============================================================================
# HBZ Website — تعیین شاخهٔ دیپلوی
# =============================================================================
# قاعده: اسکریپت‌های deploy **فقط شاخهٔ default مخزن** را می‌خوانند. هیچ شاخه‌ای
# در اسکریپت‌ها ثابت (hardcode) نشده. هر تعداد شاخه هم که داشته باشید، سرور
# همان را می‌گیرد که در GitHub → Settings → Default branch تنظیم شده است.
# با عوض‌کردن default، سرور خودکار همان را دنبال می‌کند — بدون دست‌زدن به کد.
#
# ترتیب اولویت:
#   1) --branch <x>  یا  آرگومان اول install.sh   (override دستی و موقت)
#   2) HBZ_BRANCH=<x>                              (override با متغیر محیطی)
#   3) شاخهٔ default مخزن                          ← حالت عادی
# اگر کشف default ممکن نشود، اسکریپت با خطای صریح متوقف می‌شود (حدس نمی‌زند).

# فقط برای «هشدار»، نه برای تغییر مسیر: اگر default روی یک شاخهٔ کاری موقت
# تنظیم شده باشد، اسکریپت هشدار می‌دهد ولی طبق خواستهٔ شما از همان default
# دیپلوی می‌کند.
AGENT_BRANCH_PATTERN='^(claude/|codex/|tmp/|wip/)'

# شاخهٔ default مخزن را از remote می‌خواند (خالی اگر ناموفق).
# $1 = مسیر کلون محلی (اختیاری). بدون آن، از $REPO_URL پرس‌وجو می‌شود.
resolve_default_branch() {
  local dir="${1:-}" ref=""
  if [[ -n "$dir" && -d "$dir/.git" ]]; then
    ref="$(git -C "$dir" ls-remote --symref origin HEAD 2>/dev/null | awk '/^ref:/{print $2}')"
  fi
  if [[ -z "$ref" && -n "${REPO_URL:-}" ]]; then
    ref="$(git ls-remote --symref "$REPO_URL" HEAD 2>/dev/null | awk '/^ref:/{print $2}')"
  fi
  echo "${ref#refs/heads/}"
}
