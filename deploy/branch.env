# =============================================================================
# HBZ Website — شاخهٔ رسمی تولید (single source of truth for deploys)
# =============================================================================
# همهٔ اسکریپت‌های deploy این فایل را source می‌کنند. برای تغییر شاخهٔ تولید،
# فقط همین یک مقدار را عوض کنید (نه چند اسکریپت را).
#
# چرا شاخه را «default branch» گیت‌هاب نمی‌گیریم؟ چون شاخهٔ default مخزن ممکن
# است موقتاً روی یک شاخهٔ کاری/عاملی (مثل claude/*) تنظیم شده باشد؛ در آن حالت
# سرور تولید ناخواسته کد نیمه‌کاره می‌گرفت. شاخهٔ تولید صریح و ثابت است و
# اسکریپت‌ها شاخه‌های کاری را رد می‌کنند (PROD_BRANCH_GUARD).
#
# override موقت (فقط برای تست، نه تولید):
#   HBZ_BRANCH=feature/x sudo -E bash deploy/update.sh
PROD_BRANCH="feature/v2-enterprise-upgrade"

# الگوی شاخه‌های موقتِ ممنوع برای دیپلوی تولید
PROD_BRANCH_FORBIDDEN='^(claude/|codex/|tmp/|wip/)'
