# =============================================================================
# HBZ Website — تعیین شاخهٔ دیپلوی (single source of truth)
# =============================================================================
# رفتار: اسکریپت‌های deploy شاخهٔ **default مخزن** را از remote می‌خوانند و از
# همان آپدیت می‌گیرند. یعنی هر وقت default را در GitHub عوض کنید، سرور خودکار
# همان را دنبال می‌کند — دیگر لازم نیست اسکریپت را دست بزنید.
#
# ترتیب اولویت:
#   1) --branch <x>            (آرگومان صریح)
#   2) HBZ_BRANCH=<x>          (متغیر محیطی؛ با sudo -E)
#   3) default branch مخزن     (git ls-remote --symref origin HEAD)
#   4) PROD_BRANCH پایین       (فقط اگر کشف default ممکن نشد یا موقت بود)
#
# محافظ: اگر default مخزن موقتاً روی یک شاخهٔ کاری (claude/*, wip/* …) تنظیم شده
# باشد، سرور تولید کد نیمه‌کاره نمی‌گیرد؛ با هشدار صریح به PROD_BRANCH برمی‌گردد.
# برای عبور عمدی: --allow-agent-branch
PROD_BRANCH="feature/v2-enterprise-upgrade"

# الگوی شاخه‌های موقتِ نامناسب برای تولید
PROD_BRANCH_FORBIDDEN='^(claude/|codex/|tmp/|wip/)'

# شاخهٔ default مخزن را برمی‌گرداند (خالی اگر ناموفق).
# $1 = مسیر کلون محلی (اختیاری). بدون آن، از $REPO_URL پرس‌وجو می‌شود.
resolve_default_branch() {
  local dir="${1:-}" ref=""
  if [[ -n "$dir" && -d "$dir/.git" ]]; then
    ref="$(git -C "$dir" ls-remote --symref origin HEAD 2>/dev/null | awk '/^ref:/{print $2}')"
  fi
  if [[ -z "$ref" && -n "${REPO_URL:-}" ]]; then
    ref="$(git ls-remote --symref "$REPO_URL" HEAD 2>/dev/null | awk '/^ref:/{print $2}')"
  fi
  echo "${ref#refs/heads/}"
}
