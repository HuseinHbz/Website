# =============================================================================
# HBZ Website — Environment Variables
# cp deploy/.env.example .env.local
# =============================================================================

# ── اجباری ───────────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=your-secret-min-32-chars-here
# ساخت: openssl rand -hex 32

NEXT_PUBLIC_SITE_URL=https://habibazar.ir
NEXT_PUBLIC_API_URL=https://habibazar.ir

# ── اختیاری ──────────────────────────────────────────────────────────────────

# مسیر دیتابیس SQLite (پیش‌فرض: data/habibazar.db داخل پروژه)
# DB_PATH=/var/data/habibazar/habibazar.db

# سطح لاگ: error | warn | info | debug
LOG_LEVEL=info

NODE_ENV=production
