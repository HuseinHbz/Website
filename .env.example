# ============================================================
# Habibazar Platform — Environment Variables
# Copy to .env.local and fill in the values
# ============================================================

# ── Required ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
ADMIN_JWT_SECRET=change_me_generate_with_openssl_rand_hex_64

NEXT_PUBLIC_SITE_URL=https://habibazar.ir
NEXT_PUBLIC_API_URL=https://api.habibazar.ir

# ── AI Providers (at least one required for AI Assistant) ────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Conduit — multi-model AI gateway (optional, overrides above)
CONDUIT_API_URL=
CONDUIT_API_KEY=

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=hosseinhabibazar@gmail.com

# ── Database (SQLite — auto-created on first run) ────────────
# DB_PATH=data/habibazar.db

# ── Upload / Storage ─────────────────────────────────────────
# Default: local filesystem under public/uploads
# STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
