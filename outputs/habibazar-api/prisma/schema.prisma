generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Locale {
  FA
  EN
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL
  EMAIL
  PHONE
  AI_ASSISTANT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  NURTURE
}

enum ConsultationKind {
  INTRO_CALL
  TECHNICAL
  STRATEGY
  AUDIT
  FOLLOWUP
}

enum ConsultationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EngagementStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  ACTIVE
  COMPLETED
  LOST
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum AssistantCategory {
  INFRASTRUCTURE
  CLOUD
  SECURITY
  NETWORKING
  CONSULTING
  GENERAL
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─────────────────────────────────────────────
// Identity / RBAC
// ─────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  name              String
  status            UserStatus @default(ACTIVE)
  roleId            String
  twoFactorSecret   String?   // AES-256-GCM encrypted
  twoFactorEnabled  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  role              Role      @relation(fields: [roleId], references: [id])
  sessions          Session[]
  auditLogs         AuditLog[]
  posts             Post[]
  mediaAssets       MediaAsset[]
  contentVersions   ContentVersion[]

  @@index([email])
  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@map("roles")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// CMS
// ─────────────────────────────────────────────

model Service {
  id            String        @id @default(uuid())
  slug          String        @unique
  titleFa       String
  titleEn       String
  descriptionFa String
  descriptionEn String
  icon          String?
  status        ContentStatus @default(DRAFT)
  sortOrder     Int           @default(0)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("services")
}

model CaseStudy {
  id          String        @id @default(uuid())
  slug        String        @unique
  titleFa     String
  titleEn     String
  summaryFa   String
  summaryEn   String
  bodyFa      String
  bodyEn      String
  coverImage  String?
  clientName  String?
  industry    String?
  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  metrics     CaseStudyMetric[]

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([deletedAt])
  @@map("case_studies")
}

model CaseStudyMetric {
  id          String    @id @default(uuid())
  caseStudyId String
  labelFa     String
  labelEn     String
  value       String

  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)

  @@index([caseStudyId])
  @@map("case_study_metrics")
}

model Post {
  id          String        @id @default(uuid())
  slug        String        @unique
  titleFa     String
  titleEn     String
  summaryFa   String
  summaryEn   String
  bodyFa      String
  bodyEn      String
  coverImage  String?
  authorId    String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([deletedAt])
  @@map("posts")
}

model Page {
  id        String        @id @default(uuid())
  slug      String        @unique
  titleFa   String
  titleEn   String
  bodyFa    String
  bodyEn    String
  status    ContentStatus @default(DRAFT)
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("pages")
}

model GlossaryTerm {
  id           String    @id @default(uuid())
  slug         String    @unique
  termFa       String
  termEn       String
  definitionFa String
  definitionEn String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
  @@index([deletedAt])
  @@map("glossary_terms")
}

model Category {
  id       String     @id @default(uuid())
  slug     String     @unique
  nameFa   String
  nameEn   String
  parentId String?

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryParent")

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Tag {
  id     String @id @default(uuid())
  slug   String @unique
  nameFa String
  nameEn String

  @@index([slug])
  @@map("tags")
}

model Technology {
  id   String  @id @default(uuid())
  slug String  @unique
  name String
  logo String?

  @@index([slug])
  @@map("technologies")
}

model Certification {
  id            String    @id @default(uuid())
  name          String
  issuer        String
  issuedAt      DateTime
  expiresAt     DateTime?
  credentialUrl String?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([verified])
  @@map("certifications")
}

model Testimonial {
  id            String   @id @default(uuid())
  clientName    String
  clientTitle   String?
  clientCompany String?
  clientPhoto   String?
  bodyFa        String
  bodyEn        String
  approved      Boolean  @default(false)
  consentGiven  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([approved])
  @@map("testimonials")
}

model MediaAsset {
  id           String   @id @default(uuid())
  filename     String
  mimeType     String
  size         Int
  url          String
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
  @@map("media_assets")
}

model ContentVersion {
  id         String   @id @default(uuid())
  resource   String
  resourceId String
  data       Json
  authorId   String?
  createdAt  DateTime @default(now())

  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([authorId])
  @@map("content_versions")
}

model TranslationGroup {
  id         String @id @default(uuid())
  resource   String
  resourceId String
  locale     Locale

  @@unique([resource, resourceId, locale])
  @@index([resource, resourceId])
  @@map("translation_groups")
}

// ─────────────────────────────────────────────
// Pipeline
// ─────────────────────────────────────────────

model Lead {
  id                String     @id @default(uuid())
  name              String
  email             String?
  phone             String?
  company           String?
  source            LeadSource @default(WEBSITE)
  status            LeadStatus @default(NEW)
  score             Int        @default(0)
  notes             String?
  marketingConsent  Boolean    @default(false)
  metadata          Json?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  events            LeadEvent[]
  consultations     ConsultationRequest[]
  engagements       Engagement[]
  attributions      Attribution[]

  @@index([email])
  @@index([status])
  @@index([source])
  @@index([score])
  @@index([deletedAt])
  @@map("leads")
}

model LeadEvent {
  id        String   @id @default(uuid())
  leadId    String
  event     String
  metadata  Json?
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([event])
  @@map("lead_events")
}

model ConsultationRequest {
  id            String              @id @default(uuid())
  leadId        String?
  name          String
  email         String
  phone         String?
  kind          ConsultationKind
  message       String?
  preferredDate DateTime?
  status        ConsultationStatus  @default(PENDING)
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  lead          Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([status])
  @@index([kind])
  @@index([deletedAt])
  @@map("consultation_requests")
}

model Engagement {
  id        String          @id @default(uuid())
  leadId    String
  stage     EngagementStage
  notes     String?
  value     Decimal?        @db.Decimal(15, 2)
  closedAt  DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([stage])
  @@map("engagements")
}

model Subscriber {
  id        String           @id @default(uuid())
  email     String           @unique
  locale    Locale           @default(FA)
  status    SubscriberStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([email])
  @@index([status])
  @@map("subscribers")
}

model Attribution {
  id        String   @id @default(uuid())
  leadId    String
  source    String?
  medium    String?
  campaign  String?
  content   String?
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("attributions")
}

// ─────────────────────────────────────────────
// AI
// ─────────────────────────────────────────────

model Conversation {
  id             String             @id @default(uuid())
  sessionRefHash String
  name           String?
  company        String?
  phone          String?
  category       AssistantCategory?
  locale         Locale             @default(FA)
  turnCount      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  messages       Message[]

  @@index([sessionRefHash])
  @@index([category])
  @@index([locale])
  @@index([createdAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model ContentEmbedding {
  id         String                      @id @default(uuid())
  resource   String
  resourceId String
  chunk      String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@index([resource, resourceId])
  @@map("content_embeddings")
}

// ─────────────────────────────────────────────
// Infra
// ─────────────────────────────────────────────

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  response  Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("settings")
}
