{
  "name": "habibazar-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "audit:tokens": "node scripts/design-token-audit.mjs",
    "audit:content": "node scripts/content-governance-audit.mjs",
    "audit:reuse": "node scripts/reusability-audit.mjs",
    "audit:deps": "node scripts/dependency-audit.mjs",
    "audit:links": "node scripts/link-integrity-audit.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "audit:pgcompat": "node scripts/pg-compat-audit.mjs",
    "audit": "npm run audit:tokens && npm run audit:content && npm run audit:reuse && npm run audit:deps && npm run audit:links && npm run audit:i18n && npm run audit:ui && npm run audit:tenancy && npm run audit:theme",
    "db:migrate:pg": "node scripts/migrate-to-postgres.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "audit:ui": "node scripts/ui-consistency-audit.mjs",
    "audit:tenancy": "node scripts/tenancy-audit.mjs",
    "audit:theme": "node scripts/theme-audit.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.14.1",
    "jose": "^6.2.3",
    "nanoid": "^5.1.16",
    "next": "^15.1.0",
    "next-intl": "^4.13.1",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-image-crop": "^11.1.2",
    "recharts": "^3.9.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.30.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "pg": "^8.22.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
